# Godot 4+ internal cache (DO NOT commit)
.godot/
.nomedia

# Build outputs & temporary files
*.tmp
export.cfg
export_credentials.cfg
~*.dll

# C# / Mono build folders (if applicable)
.mono/
*.csproj.html

# Assets (only commit the source PNGs, not the generated DDS files)
!/assets/pixel_art_source/
/assets/*.dds

# Personal Settings
.vscode

# UI smoke-test screenshots (regenerated on every run)
/tests/_uishots/

# Source archives. Every pack in art-resources/ is stored extracted; the .zip it came
# from is a second copy of the same bytes, so archives are not kept in the tree. The
# download URL for each pack is recorded in art-resources/ART_RESOURCES.md.
*.zip

# Multi-session register (local only — see .claude/ protocol)
working.md
